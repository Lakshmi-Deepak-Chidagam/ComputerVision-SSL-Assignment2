{
  "source": "SSL_Assignment.ipynb",
  "seed": 42,
  "input_size": [
    128,
    128
  ],
  "normalization_mean": [
    0.5,
    0.5,
    0.5
  ],
  "normalization_std": [
    0.5,
    0.5,
    0.5
  ],
  "num_classes": 16,
  "validation_fraction": 0.15,
  "split": "stratified train_test_split random_state=42",
  "batch_size": 64,
  "pretrained_weights": null,
  "supervised_augmentation": {
    "resize": [
      128,
      128
    ],
    "horizontal_flip_probability": 0.5,
    "rotation_degrees": 10
  },
  "ssl_augmentation": {
    "random_resized_crop": 128,
    "scale": [
      0.6,
      1.0
    ],
    "horizontal_flip_probability": 0.5,
    "color_jitter": [
      0.3,
      0.3,
      0.3,
      0.1
    ],
    "color_jitter_probability": 0.8,
    "grayscale_probability": 0.1
  },
  "baseline": {
    "epochs": 15,
    "optimizer": "AdamW",
    "lr": 0.001,
    "weight_decay": 0.0001,
    "loss": "cross_entropy",
    "workers": 2
  },
  "simclr": {
    "epochs": 30,
    "optimizer": "AdamW",
    "lr": 0.001,
    "weight_decay": 0.0001,
    "temperature": 0.5,
    "projection_dimensions": [
      512,
      512,
      128
    ],
    "drop_last": true,
    "workers": 0
  },
  "ssl_finetune": {
    "epochs": 15,
    "optimizer": "AdamW",
    "lr": 0.0003,
    "weight_decay": 0.0001,
    "loss": "cross_entropy"
  },
  "improved": {
    "epochs": 20,
    "optimizer": "AdamW",
    "lr": 5e-05,
    "weight_decay": 0.001,
    "label_smoothing": 0.1,
    "scheduler": "CosineAnnealingLR",
    "T_max": 20,
    "initial_checkpoint": "ssl_best.pth"
  },
  "mixup": {
    "epochs_per_run": 12,
    "runs_in_notebook": 2,
    "each_run_starts_from": "improved_best.pth",
    "second_run_overwrites_first": true,
    "optimizer": "AdamW",
    "lr": 3e-05,
    "weight_decay": 0.001,
    "alpha": 0.2
  },
  "tta": "Average original and horizontal-flip softmax probabilities",
  "selection": "Highest validation accuracy; improved TTA enabled only if validation improves.",
  "note": "This file documents constants extracted from the notebook; train.py embeds them and does not load this JSON."
}
